# Copy this file to "local.properties" (already gitignored) and fill in your
# own key. Never commit the real local.properties file.

# Path to your Android SDK (Android Studio fills this in automatically).
# sdk.dir=/path/to/Android/sdk

# OpenAI API key used for Whisper transcription (language=uk).
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The "Hey, Naomi" wake-word listener uses Vosk (free, offline, no key
# needed) — instead it needs a model folder placed at
# app/src/main/assets/model-en-us/. See README.md for the download steps.
