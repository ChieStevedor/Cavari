# Copy to .env.local for local development. Real values go in Vercel
# Environment Variables (per environment) and Supabase project settings —
# never in this file, Slack, email, or a shared doc. See docs/SECURITY.md.

# --- Supabase (required) ---------------------------------------------------

# Project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key. Safe to expose to the browser ONLY because every table
# has Row Level Security enabled — this key grants no access on its own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Bypasses Row Level Security entirely. Server-only —
# must NEVER be prefixed NEXT_PUBLIC_ and must never reach the client
# bundle. Used only by lib/supabase/admin.ts for trusted background jobs.
# Rotate every 90 days, and immediately if ever exposed (SECURITY.md).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct/session Postgres connection string, used by scripts/backup-db.sh
# (pg_dump needs a direct connection, not the pgbouncer transaction-mode
# pooler port). Found in Supabase dashboard > Project Settings > Database.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Off-platform backups (required for scripts/backup-db.sh & sync-storage.sh) ---

# Destination bucket for scheduled DB dumps and Storage sync. Must live
# outside this Supabase project (see docs/RUNBOOK-RESTORE.md, "Why a
# separate bucket").
BACKUP_BUCKET=laviius-backups

# Credentials for the bucket above, if S3-compatible (AWS CLI / rclone).
AWS_ACCESS_KEY_ID=your-backup-storage-access-key
AWS_SECRET_ACCESS_KEY=your-backup-storage-secret-key
AWS_REGION=us-west-2

# --- Rate limiting (required for public API routes) ------------------------

# Upstash Redis, used by the sliding-window rate limiter on booking/quote
# endpoints (see SECURITY.md, "API Hardening").
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Third-party APIs --------------------------------------------------

# Google Places (address autocomplete in the wizard). Server-side only
# unless a restricted browser-key variant is issued separately.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# --- CORS -------------------------------------------------------------

# Comma-separated list of origins allowed to call /api routes cross-origin.
# Keep this to known Laviius domains only (SECURITY.md, "API Hardening").
ALLOWED_ORIGINS=https://laviius.com,https://www.laviius.com
